# Server
PORT=8085
# Required. Clients must send "Authorization: Bearer <key>" to /api/chat.
# Generate one with: openssl rand -hex 32
CHAT_API_KEY=

# PocketBase (superuser account)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
# Optional comma-separated allowlist of collections the agent may read.
# Empty = all non-system collections.
POCKETBASE_ALLOWED_COLLECTIONS=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Agent
AGENT_NAME=opk-whatsapp-ai
AGENT_LOG_LEVEL=info
